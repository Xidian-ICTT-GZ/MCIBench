"type FooBar struct {\n\tn int\n}\n\nfunc NewFooBar(n int) *FooBar {\n\treturn &FooBar{n: n}\n}\n\nfunc (fb *FooBar) Foo(printFoo func()) {\n\tfor i := 0; i < fb.n; i++ {\n\t\t// printFoo() outputs \"foo\". Do not change or remove this line.\n        printFoo()\n\t}\n}\n\nfunc (fb *FooBar) Bar(printBar func()) {\n\tfor i := 0; i < fb.n; i++ {\n\t\t// printBar() outputs \"bar\". Do not change or remove this line.\n        printBar()\n\t}\n}"